@echo off
rem FocusGuard: turn filtering OFF again for this computer (back to automatic DNS).
rem Source: the same PowerShell script as focusguard-dns-windows-undo.ps1 (embedded below).
net session >nul 2>&1
if %errorlevel% neq 0 (
  echo Asking Windows for administrator permission...
  powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
  exit /b
)
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
echo.
pause
